<!DOCTYPE html>
<html>
<head>

    <title>Edit Employee</title>

    <link rel="stylesheet" href="/css/style.css">

</head>
<body>

<div class="form-page">

    <form
        action="/edit/<%= employee.id %>?_method=PUT"
        method="POST"
        class="employee-form"
    >

        <h1>Edit Employee</h1>

        <input
            type="text"
            name="employee_name"
            value="<%= employee.employee_name %>"
            required
        >

        <input
            type="email"
            name="email"
            value="<%= employee.email %>"
            required
        >

        <input
            type="text"
            name="department"
            value="<%= employee.department %>"
            required
        >

        <input
            type="text"
            name="position"
            value="<%= employee.position %>"
            required
        >

        <input
            type="number"
            step="0.01"
            name="salary"
            value="<%= employee.salary %>"
            required
        >

        <input
            type="text"
            name="country"
            value="<%= employee.country %>"
            required
        >

        <button type="submit">
            Update Employee
        </button>

    </form>

</div>

</body>
</html>